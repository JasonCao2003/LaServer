# Existing process environment takes precedence. Values are literal, not shell code.
NODE_ENV=production
LOG_LEVEL=info
ROOM_ID=main
ROOM_HOST=0.0.0.0
ROOM_PORT=25565
ROOM_MAX_PEERS=32
ROOM_MAX_PLAYERS=8
ROOM_CHANNELS=2
ROOM_TICK_RATE=5
ROOM_JOIN_TIMEOUT_MS=6000
ROOM_MAX_PACKET_BYTES=16384
ROOM_BAD_PACKET_LIMIT=8
# Administrative HTTP API; keep local unless remote access is required.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
MOVE_TARGETS=[]
# Disable raw player packet persistence by default for script-based starts.
ROOM_PACKET_JOURNAL=0
